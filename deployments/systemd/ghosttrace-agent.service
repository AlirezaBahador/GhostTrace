# Example for security review and adaptation; NOT a validated installation profile.
# Create a dedicated ghosttrace user, /etc/ghosttrace config and /var/log/ghosttrace with 0700 directory permissions.
# Capabilities vary by kernel/distro; do not add CAP_SYS_ADMIN without review.
[Unit]
Description=GhostTrace eBPF process monitoring agent (experimental)
Documentation=https://github.com/AlirezaBahador/GhostTrace
After=local-fs.target

[Service]
Type=simple
User=ghosttrace
Group=ghosttrace
ExecStart=/usr/local/bin/ghosttrace-agent -config /etc/ghosttrace/config.yaml
StandardOutput=append:/var/log/ghosttrace/events.jsonl
StandardError=journal
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/log/ghosttrace
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
